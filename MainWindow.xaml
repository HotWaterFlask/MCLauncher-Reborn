<Window x:Class="MCLauncher_reborn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCLauncher-reborn"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI">
    <Window.Resources>
        <!-- 原版风格的浅灰按钮：细边框 + 轻微渐变 + 深色文字 -->
        <Style x:Key="SkinButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#9C9C9C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FCFCFC" Offset="0"/>
                        <GradientStop Color="#EDEDED" Offset="0.5"/>
                        <GradientStop Color="#DEDEDE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F4F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CFCFCF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 叠在背景图上的白色描边文字 -->
        <Style x:Key="OverlayText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.9"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左下角署名：平时白色文字，鼠标悬停变蓝，表示可以点击 -->
        <Style x:Key="CreditLink" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New, 宋体"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter x:Name="Cp"
                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.9"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#1E90FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右上角关闭按钮：与原版一致，一块半透明白色方块，顶部最亮、向下渐透；右上角圆角与窗口一致 -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="0,8,0,3"
                                BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#B8FFFFFF" Offset="0"/>
                                    <GradientStop Color="#6BFFFFFF" Offset="0.55"/>
                                    <GradientStop Color="#26FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#D9FFFFFF" Offset="0"/>
                                    <GradientStop Color="#33FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E05A45" Offset="0"/>
                                            <GradientStop Color="#B93630" Offset="0.5"/>
                                            <GradientStop Color="#93241D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7E1B15"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#A82D24" Offset="0"/>
                                            <GradientStop Color="#7E1B15" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6B120D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 圆角窗口：外层 Border 负责圆角外形与背景皮肤，内部 Grid 把内容裁进圆角 -->
    <Border Width="720" Height="450" CornerRadius="8" MouseLeftButtonDown="OnDragMove">
        <Border.Background>
            <ImageBrush ImageSource="Assets/bgskin/bg9.jpg" Stretch="Fill"/>
        </Border.Background>

        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,720,450" RadiusX="8" RadiusY="8"/>
            </Grid.Clip>

            <!-- 左下角署名 -->
            <Button Style="{StaticResource CreditLink}"
                    Click="OnCreditClick"
                    Content="MineCraft Launcher 6.0 Reborn by 忘却的旋律"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="8,0,0,7"/>

            <!-- 右上角关闭按钮 -->
            <Button Style="{StaticResource CloseButton}"
                    Click="OnCloseClick"
                    Width="38" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0"
                    ToolTip="关闭">
                <TextBlock Text="&#x2715;" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="14">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Button>

            <!-- 右下角控件区 -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,37,33">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="31"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="31"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- 主按钮：跨三行，高度与右侧两个小按钮列对齐 -->
                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                        Style="{StaticResource SkinButton}"
                        Content="启动游戏"
                        FontSize="20" FontWeight="Bold"/>

                <Button Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource SkinButton}"
                        Content="更新游戏"
                        FontSize="13"/>

                <Button Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource SkinButton}"
                        Content="设置"
                        FontSize="13"/>

                <!-- 底部行：版本下拉框 + 打开目录 -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" HorizontalAlignment="Left">
                    <ComboBox Width="180" Height="30"
                              VerticalAlignment="Center"
                              FontSize="14" Foreground="#1A1A1A"/>
                    <TextBlock Text="打开目录"
                               Style="{StaticResource OverlayText}"
                               FontSize="15"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
