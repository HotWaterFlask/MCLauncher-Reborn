<Window x:Class="MCLauncher.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:MCLauncher.App.ViewModels"
        xmlns:views="clr-namespace:MCLauncher.App.Views"
        mc:Ignorable="d"
        Title="MCLauncher-reborn"
        Icon="pack://application:,,,/MCLauncher-Reborn.ico"
        SizeToContent="Manual"
        MinWidth="720" MinHeight="450"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Background>
        <!-- 必须用程序集绝对路径：本文件位于 Shell\ 子目录，相对路径会被解析成 shell/assets/... -->
        <ImageBrush ImageSource="pack://application:,,,/Assets/default-bg.jpg" Stretch="Fill"/>
    </Window.Background>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
            <views:VersionsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <views:AccountsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
            <views:ConnectPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LaunchLogViewModel}">
            <views:LaunchLogPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstanceManageViewModel}">
            <views:InstanceManagePage/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部横向导航 ===== -->
        <Border Grid.Row="0" Background="{StaticResource NavPanelBrush}" Padding="8,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavBarItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空白拖动区：按住即可移动窗口 -->
                <Border Grid.Column="1"
                        Background="Transparent"
                        MouseLeftButtonDown="OnDragMove"/>

                <!-- 窗口按钮：最小化始终显示；不提供最大化；关闭贴角 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WindowButton}"
                            Width="38" Height="26"
                            Click="OnMinimizeClick"
                            ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButton}"
                            Width="38" Height="26"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <TextBlock Text="&#x2715;" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="14">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 内容区：启动公告/更新横幅 + 页面 ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="8,8,8,0"
                        Visibility="{Binding HasStartupBanners, Converter={StaticResource BoolToVis}}">
                <!-- 公告：同一 id 关闭后不再显示 -->
                <Border Background="{StaticResource ContentPanelBrush}"
                        BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,6"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NoticeTitle}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource PanelTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NoticeMessage}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{StaticResource PanelSubtleTextBrush}"
                                       TextWrapping="Wrap" MaxHeight="50"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button Style="{StaticResource SkinButton}" Content="查看详情"
                                    Width="80" Height="26" FontSize="11.5"
                                    Visibility="{Binding HasNoticeUrl, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenNoticeCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="知道了"
                                    Width="66" Height="26" FontSize="11.5" Margin="8,0,0,0"
                                    Command="{Binding DismissNoticeCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 更新：用户选择「稍后提醒」后该版本不再出现 -->
                <Border Background="{StaticResource ContentPanelBrush}"
                        BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,10"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateTitle}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource PanelTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UpdateMessage}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{StaticResource PanelSubtleTextBrush}"
                                       TextWrapping="Wrap" MaxHeight="50"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button Style="{StaticResource SkinButton}" Content="查看更新"
                                    Width="80" Height="26" FontSize="11.5"
                                    Visibility="{Binding HasUpdateUrl, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenUpdateCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="稍后提醒"
                                    Width="80" Height="26" FontSize="11.5" Margin="8,0,0,0"
                                    Command="{Binding DismissUpdateCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="8,8,8,34"/>
                        <Setter Property="Background" Value="{StaticResource ContentPanelBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource ContentBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHomePage}" Value="True">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>
        </Grid>

        <!-- ===== 左下角署名：悬停变蓝，点击打开项目主页 ===== -->
        <Button Grid.Row="1"
                Style="{StaticResource CreditLink}"
                Click="OnCreditClick"
                Content="MineCraft Launcher 6.0 Reborn by 忘却的旋律"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="8,0,0,7"/>

        <!-- ===== 状态栏文字 ===== -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Style="{StaticResource OverlayText}"
                   FontSize="12"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,12,8"/>

        <!-- ===== 首次启动的初始化设置：完成前覆盖整个窗口 ===== -->
        <views:SetupView Grid.RowSpan="2" Panel.ZIndex="110"
                         DataContext="{Binding Setup}"
                         Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>

        <!-- ===== 崩溃界面：游戏异常退出后覆盖整个窗口 ===== -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="100" Background="#66000000"
              DataContext="{Binding Crash}"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="660" Height="420" Background="White" CornerRadius="8" Padding="16,12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#D8D8D8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部提示 -->
                    <Border Grid.Row="0" Background="#FDECEA" CornerRadius="6" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                       Foreground="#D0564B" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#A63A30"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#8A5A55"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 错误摘要 / 可能的原因 -->
                    <ScrollViewer Grid.Row="1" MaxHeight="132" Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#3A3A3A" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="可能的原因" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#6A6A6A" Margin="2,0,0,4"/>

                            <ItemsControl ItemsSource="{Binding Causes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F9FB" CornerRadius="4"
                                                Padding="8,6" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="#A63A30"/>
                                                <TextBlock Text="{Binding Advice}" FontSize="10.5"
                                                           Foreground="#5A5A5A" TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 崩溃日志 -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="崩溃日志" FontSize="11"
                                   FontWeight="SemiBold" Foreground="#6A6A6A" Margin="2,0,0,4"/>
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 Background="#F7F8FA" BorderBrush="#E2E6EC" BorderThickness="1"
                                 FontFamily="Consolas, Courier New, 宋体" FontSize="10.5"
                                 Padding="6" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MinHeight="90"/>
                    </DockPanel>

                    <!-- 操作 -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Hint}" FontSize="10.5" Foreground="#7A7A7A"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SkinButton}" Content="打开崩溃报告"
                                    Width="104" Height="28" FontSize="12"
                                    Command="{Binding OpenReportCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="打开实例目录"
                                    Width="104" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="复制日志"
                                    Width="82" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding CopyLogCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="重新启动"
                                    Width="82" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding RestartCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="关闭"
                                    Width="66" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding CloseCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
