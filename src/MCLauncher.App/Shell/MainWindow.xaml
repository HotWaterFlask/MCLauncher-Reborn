<Window x:Class="MCLauncher.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:MCLauncher.App.ViewModels"
        xmlns:views="clr-namespace:MCLauncher.App.Views"
        mc:Ignorable="d"
        Title="MCLauncher-reborn"
        Icon="pack://application:,,,/MCLauncher-Reborn.ico"
        SizeToContent="Manual"
        MinWidth="720" MinHeight="450"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Background>
        <!-- 必须用程序集绝对路径：本文件位于 Shell\ 子目录，相对路径会被解析成 shell/assets/... -->
        <ImageBrush ImageSource="pack://application:,,,/Assets/bgskin/bg9.jpg" Stretch="Fill"/>
    </Window.Background>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
            <views:VersionsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <views:AccountsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LaunchLogViewModel}">
            <views:LaunchLogPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部横向导航 ===== -->
        <Border Grid.Row="0" Background="{StaticResource NavPanelBrush}" Padding="8,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavBarItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空白拖动区：按住即可移动窗口 -->
                <Border Grid.Column="1"
                        Background="Transparent"
                        MouseLeftButtonDown="OnDragMove"/>

                <!-- 窗口按钮：最小化始终显示；不提供最大化；关闭贴角 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WindowButton}"
                            Width="38" Height="26"
                            Click="OnMinimizeClick"
                            ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButton}"
                            Width="38" Height="26"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <TextBlock Text="&#x2715;" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="14">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Border Grid.Row="1"
                Margin="8,8,8,34"
                Background="{StaticResource ContentPanelBrush}"
                BorderBrush="{StaticResource ContentBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>

        <!-- ===== 左下角署名：悬停变蓝，点击打开项目主页 ===== -->
        <Button Grid.Row="1"
                Style="{StaticResource CreditLink}"
                Click="OnCreditClick"
                Content="MineCraft Launcher 6.0 Reborn by 忘却的旋律"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="8,0,0,7"/>

        <!-- ===== 状态栏文字 ===== -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Style="{StaticResource OverlayText}"
                   FontSize="12"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,12,8"/>
    </Grid>
</Window>
