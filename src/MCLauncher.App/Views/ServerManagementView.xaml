<UserControl x:Class="MCLauncher.App.Views.ServerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="490">
    <UserControl.Resources>
        <!-- 服务器行 -->
        <Style x:Key="ServerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F9FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="14,12,14,10">
        <!-- 标题 -->
        <Grid DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="服务器管理" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Servers.Count, StringFormat=共 {0} 个}"
                           FontSize="11" Foreground="#7A7A7A" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource SkinButton}"
                    Command="{Binding RefreshCommand}" Content="刷新"
                    Width="66" Height="26" FontSize="12"/>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0"
                   Style="{StaticResource BodyText}" TextWrapping="Wrap"
                   Text="列表与游戏内的「多人游戏」共用实例目录下的 servers.dat；修改会自动保存。"/>

        <!-- 底部状态 -->
        <Border DockPanel.Dock="Bottom" Padding="10,8" Margin="0,8,0,0" Background="#F7F7F7"
                BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#5A5A5A"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
        </Border>

        <!-- 列表 + 右侧操作栏 + 底部编辑区 -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="66"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#E2E6EC" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#F7F7F7" Height="24">
                        <TextBlock Text="名称" Margin="74,0,0,0" FontSize="11" Foreground="#5A5A5A"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="地址" HorizontalAlignment="Right" Margin="0,0,10,0"
                                   FontSize="11" Foreground="#5A5A5A" VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ServerItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="62" Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center">
                                        <Border Background="#F1F5F9" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="20" Foreground="#7A93B5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="8,0,10,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Address}"
                                               FontSize="11" Foreground="#5A5A5A"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="180"
                                               ToolTip="{Binding Address}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧操作 -->
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,0">
                <Button Style="{StaticResource SkinButton}" Content="添加"
                        Command="{Binding AddCommand}" Height="26" FontSize="12" Margin="0,0,0,6"/>
                <Button Style="{StaticResource SkinButton}" Content="删除"
                        Command="{Binding RemoveCommand}" Height="26" FontSize="12" Margin="0,0,0,6"/>
                <Button Style="{StaticResource SkinButton}" Content="上移"
                        Command="{Binding MoveUpCommand}" Height="26" FontSize="12" Margin="0,0,0,6"/>
                <Button Style="{StaticResource SkinButton}" Content="下移"
                        Command="{Binding MoveDownCommand}" Height="26" FontSize="12" Margin="0,0,0,6"/>
                <Button Style="{StaticResource SkinButton}" Content="加入"
                        Command="{Binding JoinCommand}" Height="26" FontSize="12"/>
            </StackPanel>

            <!-- 编辑区 -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0"
                  IsEnabled="{Binding HasSelection}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" FontSize="12"
                           VerticalAlignment="Center" Foreground="#1A1A1A"/>
                <TextBox Grid.Row="0" Grid.Column="1" Height="26" FontSize="12" Padding="6,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="地址" FontSize="12" Margin="0,6,0,0"
                           VerticalAlignment="Center" Foreground="#1A1A1A"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="26" FontSize="12" Padding="6,0" Margin="0,6,0,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="host 或 host:port，例如 play.example.com:25565"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="资源" FontSize="12" Margin="0,6,0,0"
                           VerticalAlignment="Center" Foreground="#1A1A1A"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Height="26" FontSize="12" Margin="0,6,0,0"
                          HorizontalAlignment="Left" Width="160"
                          ItemsSource="{Binding ResourcePolicies}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}"
                          ToolTip="进入服务器时如何处理服务器资源包"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
