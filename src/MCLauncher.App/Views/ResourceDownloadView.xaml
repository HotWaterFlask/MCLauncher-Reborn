<UserControl x:Class="MCLauncher.App.Views.ResourceDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <UserControl.Resources>
        <Style x:Key="DownloadItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F9FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#66000000">
        <Border Width="660" MaxHeight="430" Background="White" CornerRadius="8" Padding="16,12"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#D8D8D8" BorderThickness="1">
            <DockPanel>
                <!-- 标题 -->
                <Grid DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PageText}" FontSize="11" Foreground="#7A7A7A"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource SkinButton}"
                            Command="{Binding CloseCommand}" Content="关闭"
                            Width="66" Height="26" FontSize="12"/>
                </Grid>

                <!-- 筛选 -->
                <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Height="26" FontSize="12" Padding="6,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按项目名称搜索，支持中英文">
                    </TextBox>

                    <ComboBox Grid.Column="1" Width="108" Height="26" FontSize="12" Margin="8,0,0,0"
                              ItemsSource="{Binding GameVersionOptions}"
                              SelectedItem="{Binding SelectedGameVersion, Mode=TwoWay}"
                              ToolTip="筛选支持该游戏版本的项目"/>

                    <ComboBox Grid.Column="2" Width="108" Height="26" FontSize="12" Margin="8,0,0,0"
                              ItemsSource="{Binding SortOptions}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                              ToolTip="排序方式"/>

                    <Button Grid.Column="3" Style="{StaticResource SkinButton}"
                            Command="{Binding SearchCommand}" Content="搜索"
                            Width="66" Height="26" FontSize="12" Margin="8,0,0,0"/>
                </Grid>

                <!-- 底部：进度 / 翻页 / 状态 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <ProgressBar Height="5" Minimum="0" Maximum="1" Margin="0,0,0,6"
                                 Value="{Binding DownloadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>

                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SkinButton}" Content="上一页"
                                    Command="{Binding PreviousPageCommand}"
                                    Width="66" Height="26" FontSize="12"/>
                            <Button Style="{StaticResource SkinButton}" Content="下一页"
                                    Command="{Binding NextPageCommand}"
                                    Width="66" Height="26" FontSize="12" Margin="6,0,0,0"/>
                        </StackPanel>

                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StatusText}" FontSize="11" Foreground="#5A5A5A"
                                   TextTrimming="CharacterEllipsis" MaxWidth="470"
                                   ToolTip="{Binding StatusText}"/>
                    </Grid>
                </StackPanel>

                <!-- 结果列表 -->
                <Border Margin="0,10,0,0" BorderBrush="#E2E6EC" BorderThickness="1" Background="White">
                    <ListBox ItemsSource="{Binding Results}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource DownloadItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="62" Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                                        <Border Background="#F1F5F9" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="17" Foreground="#7A93B5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding Icon}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                            <ItemsControl ItemsSource="{Binding Categories}" Margin="8,0,0,0"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#E8EEF7" CornerRadius="3"
                                                                Padding="5,1" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding}" FontSize="10"
                                                                       Foreground="#3F628E"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#8A8A8A"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="430"/>
                                        <TextBlock Text="{Binding DownloadText}" FontSize="10"
                                                   Foreground="#A0A0A0" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource SkinButton}"
                                            Content="下载" Width="64" Height="26" FontSize="12"
                                            VerticalAlignment="Center"
                                            Command="{Binding ElementName=Root, Path=DataContext.DownloadCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
