<UserControl x:Class="MCLauncher.App.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="账号" Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,10"
                   Style="{StaticResource BodyText}"
                   Text="{Binding SelectedAccountText}"/>

        <!-- 账号列表 + 操作 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6"
                BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Padding="10,8" Background="#F7F7F7"
                        BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="150" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                                 Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="离线玩家名（不超过 16 字符）"/>
                        <Button Style="{StaticResource SkinButton}"
                                Command="{Binding AddOfflineCommand}"
                                Content="添加离线账号"
                                Width="112" Height="28" FontSize="13" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource SkinButton}"
                                Command="{Binding SelectCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=AccountList}"
                                Content="设为当前"
                                Width="88" Height="28" FontSize="13" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource SkinButton}"
                                Command="{Binding RemoveCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=AccountList}"
                                Content="删除"
                                Width="72" Height="28" FontSize="13" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="AccountList"
                         ItemsSource="{Binding Accounts}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" FontSize="13" Margin="10,7"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 微软正版登录 -->
        <TextBlock Grid.Row="3" Text="微软正版登录" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
        <Border Grid.Row="4" Background="White" CornerRadius="6" Padding="12"
                BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding MsClientIdHint}"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}" Text="{Binding MsRedirectHint}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource SkinButton}"
                            Command="{Binding LoginMicrosoftCommand}"
                            Content="浏览器登录"
                            Width="110" Height="28" FontSize="13"
                            ToolTip="打开系统浏览器授权，需要 Azure 应用注册 http://localhost 回调地址"/>
                    <Button Style="{StaticResource SkinButton}"
                            Command="{Binding LoginByDeviceCodeCommand}"
                            Content="设备码登录"
                            Width="120" Height="28" FontSize="13" Margin="8,0,0,0"
                            ToolTip="不需要注册任何回调地址：在浏览器里输入一个短码即可"/>
                    <Button Style="{StaticResource SkinButton}"
                            Command="{Binding CancelLoginCommand}"
                            Content="取消登录"
                            Width="88" Height="28" FontSize="13" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 设备码：大字显示短码，方便对照着输入 -->
                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="6"
                        Background="#FFF8E6" BorderBrush="#E8D9A8" BorderThickness="1"
                        Visibility="{Binding HasDeviceCode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="验证码" VerticalAlignment="Center" FontSize="13" Foreground="#6B5B1E"/>
                        <TextBlock Text="{Binding DeviceCodeText}" Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas, Courier New" FontSize="24" FontWeight="Bold"
                                   Foreground="#1A1A1A"/>
                        <Button Style="{StaticResource SkinButton}"
                                Command="{Binding OpenDeviceCodePageCommand}"
                                Content="打开验证页"
                                Width="96" Height="28" FontSize="13" Margin="16,0,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyText}" Text="{Binding StatusText}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
