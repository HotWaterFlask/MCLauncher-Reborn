<UserControl x:Class="MCLauncher.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" Style="{StaticResource PageTitle}"/>

        <!-- ===== 全局设置 ===== -->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 游戏目录 -->
                <TextBlock Text="游戏目录" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}"
                             Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SkinButton}"
                            Command="{Binding BrowseGameFolderCommand}"
                            Content="浏览…" Width="72" Height="26" FontSize="13"/>
                </Grid>

                <!-- 下载源 -->
                <TextBlock Text="下载源" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本列表源"
                               VerticalAlignment="Center" FontSize="13" Foreground="#1A1A1A"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="180" Height="26" Margin="12,0,0,0"
                              HorizontalAlignment="Right" FontSize="13"
                              ItemsSource="{Binding DownloadSourceChoices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding VersionListSource, Mode=TwoWay}"
                              ToolTip="版本清单与版本 JSON 的获取源"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="下载源" Margin="0,8,0,0"
                               VerticalAlignment="Center" FontSize="13" Foreground="#1A1A1A"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Width="180" Height="26" Margin="12,8,0,0"
                              HorizontalAlignment="Right" FontSize="13"
                              ItemsSource="{Binding DownloadSourceChoices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding FileSource, Mode=TwoWay}"
                              ToolTip="客户端、依赖库与资源对象的下载源"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="附加内容默认下载源" Margin="0,8,0,0"
                               VerticalAlignment="Center" FontSize="13" Foreground="#1A1A1A"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Width="180" Height="26" Margin="12,8,0,0"
                              HorizontalAlignment="Right" FontSize="13"
                              ItemsSource="{Binding ContentSourceChoices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding DefaultContentSource, Mode=TwoWay}"
                              ToolTip="模组、资源包、光影与整合包的默认检索源"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           Text="自动模式会在启动时探测镜像连通性；镜像不可用时自动改用官方源。附加内容指模组、资源包、光影与整合包。"/>

                <!-- 下载线程数 -->
                <TextBlock Text="下载线程数" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <RadioButton Content="自动选择线程数"
                             GroupName="DownloadThreads"
                             IsChecked="{Binding AutoDownloadThreads, Mode=TwoWay}"
                             FontSize="13" Foreground="#1A1A1A"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="自定义线程数"
                                 GroupName="DownloadThreads"
                                 IsChecked="{Binding CustomDownloadThreads, Mode=TwoWay}"
                                 FontSize="13" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Margin="16,0,12,0"
                            Minimum="1" Maximum="64"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding DownloadThreads, Mode=TwoWay}"
                            IsEnabled="{Binding CustomDownloadThreads}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Width="110" TextAlignment="Right"
                               VerticalAlignment="Center" FontSize="12" Foreground="#5A5A5A"
                               Text="{Binding DownloadThreadsText}"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           Text="自动模式使用 16 并发；镜像源对单个主机本身有限流，调得过高不会更快。"/>

                <!-- 背景图 -->
                <TextBlock Text="背景图" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <RadioButton Content="默认底图"
                             GroupName="BackgroundMode"
                             IsChecked="{Binding IsBackgroundDefault, Mode=TwoWay}"
                             FontSize="13" Foreground="#1A1A1A"/>
                <RadioButton Content="目录模式（bgskin）" Margin="0,6,0,0"
                             GroupName="BackgroundMode"
                             IsChecked="{Binding IsBackgroundFolder, Mode=TwoWay}"
                             FontSize="13" Foreground="#1A1A1A"/>
                <TextBlock Margin="24,3,0,0" Style="{StaticResource BodyText}"
                           Text="选择后自动创建该目录；把图片放进去，每次启动随机显示一张。"/>
                <StackPanel Margin="24,4,0,0" Orientation="Horizontal"
                            Visibility="{Binding IsBackgroundFolder, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding BackgroundFolderPath}" FontSize="11" Foreground="#7A7A7A"
                               VerticalAlignment="Center" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                    <Button Content="打开目录" Style="{StaticResource SkinButton}"
                            Command="{Binding OpenBackgroundFolderCommand}"
                            Width="76" Height="24" FontSize="12" Margin="10,0,0,0"/>
                </StackPanel>

                <RadioButton Content="自定义模式（目录或图片文件）" Margin="0,8,0,0"
                             GroupName="BackgroundMode"
                             IsChecked="{Binding IsBackgroundCustom, Mode=TwoWay}"
                             FontSize="13" Foreground="#1A1A1A"/>
                <Grid Margin="24,4,0,0" IsEnabled="{Binding IsBackgroundCustom}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding BackgroundCustomPath, UpdateSourceTrigger=PropertyChanged}"
                             Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="12"/>
                    <Button Grid.Column="1" Content="浏览图片…" Style="{StaticResource SkinButton}"
                            Command="{Binding BrowseBackgroundFileCommand}"
                            Width="86" Height="26" FontSize="12" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="浏览目录…" Style="{StaticResource SkinButton}"
                            Command="{Binding BrowseBackgroundFolderCommand}"
                            Width="86" Height="26" FontSize="12" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Margin="24,3,0,0" Style="{StaticResource BodyText}"
                           Text="选择目录则从目录中随机取图；选择图片文件则固定显示该图片。"/>

                <RadioButton Content="网络模式（图片 URL）" Margin="0,8,0,0"
                             GroupName="BackgroundMode"
                             IsChecked="{Binding IsBackgroundNetwork, Mode=TwoWay}"
                             FontSize="13" Foreground="#1A1A1A"/>
                <TextBox Margin="24,4,0,0" Height="26" FontSize="12"
                         VerticalContentAlignment="Center" Padding="6,0"
                         IsEnabled="{Binding IsBackgroundNetwork}"
                         Text="{Binding BackgroundUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="图片直链；支持每次返回不同图片的随机图 API"/>
                <TextBlock Margin="24,3,0,0" Style="{StaticResource BodyText}"
                           Text="每次启动都会重新下载；随机图片 API 每次启动即可显示不同图片。"/>

                <!-- Java -->
                <TextBlock Text="Java 运行时" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                             Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SkinButton}"
                            Command="{Binding BrowseJavaCommand}"
                            Content="浏览…" Width="72" Height="26" FontSize="13"/>
                    <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SkinButton}"
                            Command="{Binding DetectJavaCommand}"
                            Content="自动探测" Width="88" Height="26" FontSize="13"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}" Text="{Binding JavaHint}"/>
                <ListBox ItemsSource="{Binding Javas}" SelectedItem="{Binding SelectedJava, Mode=TwoWay}"
                         Height="96" Margin="0,8,0,0"
                         Background="White" BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Display}" FontSize="12"/>
                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#8A8A8A"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           Text="点击列表中的运行时即可设为当前 Java；缺少合适版本时，启动游戏会自动下载 Zulu JDK。"/>

                <!-- 内存 -->
                <TextBlock Text="内存" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="最大" VerticalAlignment="Center" FontSize="13" Foreground="#1A1A1A"/>
                    <TextBox Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" Margin="8,0,0,0"
                             Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                    <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" Foreground="#1A1A1A"/>
                    <TextBlock Text="初始" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="13" Foreground="#1A1A1A"/>
                    <TextBox Text="{Binding MinMemoryMb, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" Margin="8,0,0,0"
                             Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                    <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" Foreground="#1A1A1A"/>
                </StackPanel>

                <!-- 游戏窗口 -->
                <TextBlock Text="游戏窗口" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <RadioButton Grid.Row="0" Grid.Column="0" Content="窗口化"
                                 GroupName="GameWindow"
                                 IsChecked="{Binding IsWindowed, Mode=TwoWay}"
                                 FontSize="13" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Margin="16,0,0,0" Width="160" Height="26"
                              HorizontalAlignment="Left"
                              FontSize="13"
                              IsEditable="True"
                              ItemsSource="{Binding WindowSizePresets}"
                              Text="{Binding GameWindowSize, UpdateSourceTrigger=LostFocus}"
                              IsEnabled="{Binding IsWindowed}"
                              ToolTip="选择预设，或直接输入「宽x高」，例如 1366x768"/>

                    <RadioButton Grid.Row="1" Grid.Column="0" Content="全屏" Margin="0,8,0,0"
                                 GroupName="GameWindow"
                                 IsChecked="{Binding IsFullscreen, Mode=TwoWay}"
                                 FontSize="13" Foreground="#1A1A1A"/>
                    <RadioButton Grid.Row="2" Grid.Column="0" Content="最大化" Margin="0,8,0,0"
                                 GroupName="GameWindow"
                                 IsChecked="{Binding IsMaximized, Mode=TwoWay}"
                                 FontSize="13" Foreground="#1A1A1A"/>
                </Grid>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Text="窗口大小可选预设，也可以直接输入数字；「最大化」按主显示器分辨率启动。首次使用时会按显示器分辨率自动选择一次，之后以你的设置为准。"/>

                <!-- 快速游玩 -->
                <TextBlock Text="快速游玩" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <RadioButton Content="不自动进入"
                             GroupName="QuickPlay"
                             IsChecked="{Binding IsQuickPlayNone, Mode=TwoWay}"
                             FontSize="13" Foreground="#1A1A1A"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="进入多人游戏"
                                 GroupName="QuickPlay"
                                 IsChecked="{Binding IsQuickPlayMultiplayer, Mode=TwoWay}"
                                 FontSize="13" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="12,0,0,0" Height="26"
                             VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                             IsEnabled="{Binding IsQuickPlayMultiplayer}"
                             Text="{Binding QuickPlayServer, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="服务器地址，例如 mc.example.com 或 mc.example.com:25565"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="进入单人存档"
                                 GroupName="QuickPlay"
                                 IsChecked="{Binding IsQuickPlaySingleplayer, Mode=TwoWay}"
                                 FontSize="13" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="12,0,0,0" Height="26"
                             VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                             IsEnabled="{Binding IsQuickPlaySingleplayer}"
                             Text="{Binding QuickPlayWorld, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="saves 目录下的存档文件夹名"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="进入 Realms"
                                 GroupName="QuickPlay"
                                 IsChecked="{Binding IsQuickPlayRealms, Mode=TwoWay}"
                                 FontSize="13" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="12,0,0,0" Height="26"
                             VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                             IsEnabled="{Binding IsQuickPlayRealms}"
                             Text="{Binding QuickPlayRealmsId, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Realms 服务器 ID"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Text="多人游戏在 1.20 及以上使用快速加入参数，更早版本退回服务器与端口参数；单人存档与 Realms 需要 1.20 及以上。"/>

                <!-- 附加参数 -->
                <TextBlock Text="附加启动参数" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <TextBlock Style="{StaticResource BodyText}" Text="JVM 参数（支持 ${version_name} 等变量）"/>
                <TextBox Text="{Binding ExtraJvmArgs, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0" Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                <TextBlock Style="{StaticResource BodyText}" Text="游戏参数" Margin="0,8,0,0"/>
                <TextBox Text="{Binding ExtraGameArgs, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0" Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>

                <!-- 游戏运行路径 -->
                <TextBlock Text="游戏运行路径" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding LaunchWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SkinButton}"
                            Command="{Binding BrowseWorkingDirectoryCommand}"
                            Content="浏览…" Width="72" Height="26" FontSize="13"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Text="留空时使用实例目录；相对路径按游戏目录解析，目录不存在会自动创建。"/>

                <!-- 环境变量 -->
                <TextBlock Text="环境变量" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <TextBox Text="{Binding EnvironmentVariablesText, UpdateSourceTrigger=PropertyChanged}"
                         Height="76" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Padding="6,4" FontFamily="Consolas, 宋体" FontSize="12"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Text="每行一个 NAME=VALUE；以 # 开头的行会被忽略。变量只传给游戏进程，不影响启动器本身。"/>

                <!-- 进程与启动器 -->
                <TextBlock Text="进程与启动器" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏进程优先级"
                               VerticalAlignment="Center" FontSize="13" Foreground="#1A1A1A"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="220" Height="26" Margin="12,0,0,0"
                              HorizontalAlignment="Left" FontSize="13"
                              ItemsSource="{Binding ProcessPriorityChoices}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding ProcessPriority, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏启动后" Margin="0,8,0,0"
                               VerticalAlignment="Center" FontSize="13" Foreground="#1A1A1A"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Width="220" Height="26" Margin="12,8,0,0"
                              HorizontalAlignment="Left" FontSize="13"
                              ItemsSource="{Binding LauncherVisibilityChoices}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding LauncherVisibility, Mode=TwoWay}"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Text="「隐藏，游戏结束后重新打开」会在游戏退出后自动恢复启动器；游戏崩溃时也会显示启动器以便查看报告。"/>

                <!-- 启动前检查 -->
                <TextBlock Text="启动前检查" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <CheckBox Content="跳过完整性与缺失文件检查（启动更快，缺文件时可能直接启动失败）"
                          IsChecked="{Binding SkipIntegrityCheck}"
                          FontSize="13" Foreground="#1A1A1A"/>

                <!-- 自定义命令 -->
                <TextBlock Text="自定义命令" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <TextBlock Style="{StaticResource BodyText}" Text="包装命令（放在 java 命令前面，可选）"/>
                <TextBox Text="{Binding WrapperCommand, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0" Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                <TextBlock Style="{StaticResource BodyText}" Text="启动前命令（cmd 语法，非 0 退出码会阻止启动）" Margin="0,8,0,0"/>
                <TextBox Text="{Binding PreLaunchCommand, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0" Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                <TextBlock Style="{StaticResource BodyText}" Text="结束后命令（cmd 语法，游戏退出后执行）" Margin="0,8,0,0"/>
                <TextBox Text="{Binding PostLaunchCommand, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0" Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Text="三条命令都在游戏进程的工作目录执行，输出会写入启动器日志。"/>

                <!-- 版本隔离 -->
                <TextBlock Text="版本隔离" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <CheckBox Content="默认启用版本隔离（mods / 存档与其它版本分开）"
                          IsChecked="{Binding DefaultIsolation}"
                          FontSize="13" Foreground="#1A1A1A"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           Text="实例设置里可以单独覆盖，选择「跟随全局」时就按这里的值。"/>

                <!-- 配置位置 -->
                <TextBlock Text="配置文件位置" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding ConfigDirectory}" FontFamily="Consolas, 宋体"/>
                <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                        Style="{StaticResource SkinButton}"
                        Command="{Binding OpenLogDirectoryCommand}"
                        Content="打开日志目录" Width="110" Height="26" FontSize="12"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource SkinButton}"
                            Command="{Binding SaveCommand}"
                            Content="保存设置"
                            Width="110" Height="30" FontSize="13"/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource BodyText}"
                               Text="{Binding StatusText}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
