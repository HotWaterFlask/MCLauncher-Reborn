<UserControl x:Class="MCLauncher.App.Views.EngineManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="490">
    <UserControl.Resources>
        <Style x:Key="ComponentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F9FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCancelStyle" TargetType="Button" BasedOn="{StaticResource SkinButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogVersionListStyle" TargetType="ListBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoadingVersions}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="14,12,14,10">
            <!-- 标题 -->
            <Grid DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="引擎管理" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding InstanceDisplay}" FontSize="12" Foreground="#2F6FB6"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource SkinButton}"
                        Command="{Binding RefreshCommand}" Content="刷新"
                        Width="66" Height="26" FontSize="12"/>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0"
                       Style="{StaticResource BodyText}" TextWrapping="Wrap"
                       Text="安装加载器会创建一个基于当前实例的新实例；卸载后实例恢复为原版启动，存档与配置保留。"/>

            <!-- 底部状态 -->
            <Border DockPanel.Dock="Bottom" Padding="10,8" Margin="0,8,0,0" Background="#F7F7F7"
                    BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#5A5A5A"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
            </Border>

            <!-- 组件列表 -->
            <ListBox ItemsSource="{Binding Components}"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ComponentItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="58" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                    Background="{Binding BadgeColor}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}" Foreground="White"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#8A8A8A"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SkinButton}"
                                        Content="安装" Width="64" Height="26" FontSize="12"
                                        Command="{Binding ElementName=Root, Path=DataContext.OpenInstallCommand}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource SkinButton}"
                                        Content="卸载" Width="64" Height="26" FontSize="12"
                                        Command="{Binding ElementName=Root, Path=DataContext.UninstallCommand}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 版本选择 / 安装进度 -->
        <Grid Background="#66000000" Panel.ZIndex="20"
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="420" MaxHeight="420" Background="White" CornerRadius="8" Padding="18,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#D8D8D8" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DialogSubtitle}" FontSize="11" Foreground="#7A7A7A"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <ProgressBar Height="6" Minimum="0" Maximum="1"
                                     Value="{Binding InstallProgress, Mode=OneWay}"
                                     Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding InstallStatus}" Margin="0,6,0,0"
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Style="{StaticResource SkinButton}"
                                    Content="安装" Width="90" Height="28" FontSize="12"
                                    Command="{Binding ConfirmInstallCommand}"
                                    IsEnabled="{Binding CanConfirmInstall}"/>
                            <Button Style="{StaticResource DialogCancelStyle}"
                                    Content="取消" Width="76" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding CancelInstallCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <ListBox Height="180" Margin="0,10,0,0"
                             ItemsSource="{Binding LoaderVersions}"
                             SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                             DisplayMemberPath="Display"
                             Style="{StaticResource DialogVersionListStyle}"
                             Background="White" BorderBrush="#E2E6EC" BorderThickness="1"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
