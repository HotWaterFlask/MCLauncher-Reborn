<UserControl x:Class="MCLauncher.App.Views.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="版本管理" Style="{StaticResource PageTitle}"/>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                     ToolTip="按版本号搜索"/>
            <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="显示快照" FontSize="13" Foreground="#1A1A1A"
                      IsChecked="{Binding ShowSnapshots}"/>
            <CheckBox Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="显示远古版本" FontSize="13" Foreground="#1A1A1A"
                      IsChecked="{Binding ShowOldVersions}"/>
            <Button Grid.Column="4" Style="{StaticResource SkinButton}"
                    Command="{Binding RefreshCommand}"
                    Content="刷新列表"
                    Width="92" Height="26" FontSize="13"/>
        </Grid>

        <!-- 两栏：远端清单 / 已安装 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6"
                    BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="10,8" Background="#F7F7F7"
                            BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource SkinButton}"
                                Command="{Binding InstallCommand}"
                                Content="安装选中版本"
                                Height="28" FontSize="13" HorizontalAlignment="Stretch"/>
                    </Border>
                    <ListBox ItemsSource="{Binding RemoteVersions}"
                             SelectedItem="{Binding SelectedRemote, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,4" Height="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontSize="11"
                                               Foreground="#5A5A5A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ReleaseTime}" FontSize="11"
                                               Foreground="#8A8A8A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="6"
                    BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="已安装版本" Style="{StaticResource SectionTitle}"
                               Margin="10,10,10,0"/>
                    <Border DockPanel.Dock="Bottom" Padding="10,8" Background="#F7F7F7"
                            BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <CheckBox Content="版本隔离"
                                      IsChecked="{Binding IsSelectedIsolated}"
                                      FontSize="12" Foreground="#1A1A1A"
                                      ToolTip="开启后该版本的 mods / 存档 / 配置都放在自己的目录里，与其它版本互不影响"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource SkinButton}"
                                        Command="{Binding CompleteCommand}"
                                        Content="补全"
                                        Width="82" Height="28" FontSize="13"/>
                                <Button Style="{StaticResource SkinButton}"
                                        Command="{Binding DeleteCommand}"
                                        Content="删除"
                                        Width="82" Height="28" FontSize="13" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding InstalledVersions}"
                             SelectedItem="{Binding SelectedInstalled, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             Margin="4,8,4,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,5">
                                    <TextBlock Text="{Binding Id}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding LoaderName}" FontSize="11" Foreground="#5A5A5A"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 加载器安装：装到右侧选中实例的基底原版上 -->
        <Border Grid.Row="3" Margin="0,10,0,0" Background="White" CornerRadius="6" Padding="12,10"
                BorderBrush="{StaticResource ContentBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="加载器" VerticalAlignment="Center" FontSize="13" Foreground="#1A1A1A"/>
                <ComboBox Grid.Column="1" Width="110" Height="26" Margin="8,0,0,0" FontSize="13"
                          ItemsSource="{Binding LoaderKinds}"
                          SelectedItem="{Binding SelectedLoaderKind, Mode=TwoWay}"/>
                <ComboBox Grid.Column="2" Width="150" Height="26" Margin="8,0,0,0" FontSize="13"
                          ItemsSource="{Binding LoaderVersions}"
                          SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          ToolTip="先点「获取版本」再选择"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource SkinButton}"
                            Command="{Binding LoadLoaderVersionsCommand}"
                            Content="获取版本"
                            Width="82" Height="26" FontSize="13"/>
                    <Button Style="{StaticResource SkinButton}"
                            Command="{Binding InstallLoaderCommand}"
                            Content="安装加载器"
                            Width="96" Height="26" FontSize="13" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource BodyText}" Text="{Binding LoaderTargetText}"/>
            </Grid>
        </Border>

        <!-- 进度与状态 -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Height="6" Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource BodyText}" Text="{Binding StatusText}"/>
        </Grid>
    </Grid>
</UserControl>
