<UserControl x:Class="MCLauncher.App.Views.InstanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="490">
    <DockPanel Margin="14,12,14,10">
        <!-- 标题与实例目录 -->
        <Grid DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="实例设置" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding InstanceDisplay}" FontSize="12" Foreground="#2F6FB6"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource SkinButton}"
                    Command="{Binding OpenFolderCommand}"
                    Content="打开实例目录" Width="100" Height="26" FontSize="12"/>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding InstanceDirectory}"
                   Margin="0,6,0,0" FontSize="10" Foreground="#8A8A8A"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding InstanceDirectory}"/>

        <!-- 底部操作 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SkinButton}"
                        Command="{Binding SaveCommand}"
                        Content="保存实例设置"
                        Width="120" Height="30" FontSize="13"/>
                <Button Style="{StaticResource SkinButton}"
                        Command="{Binding ResetCommand}"
                        Content="恢复默认"
                        Width="96" Height="30" FontSize="13" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Margin="0,6,0,0"
                       Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxHeight="34"
                       ToolTip="{Binding Status}"/>
        </StackPanel>

        <!-- 表单 -->
        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="实例名称" Style="{StaticResource SectionTitle}" Margin="0,6,0,8"/>
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                         ToolTip="显示在实例列表与首页下拉框里的名称"/>

                <TextBlock Text="版本隔离" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                <ComboBox Width="180" Height="28" FontSize="13" HorizontalAlignment="Left"
                          ItemsSource="{Binding IsolationOptions}"
                          SelectedItem="{Binding SelectedIsolationOption, Mode=TwoWay}"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           Text="开启后 mods / 存档 / 配置都在 versions/&lt;实例&gt; 下；跟随全局时使用全局默认值。"/>

                <TextBlock Text="内存" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="最大" VerticalAlignment="Center" FontSize="13" Foreground="#1A1A1A"/>
                    <TextBox Text="{Binding MaxMemory, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" Margin="8,0,0,0" Height="26" FontSize="13"
                             VerticalContentAlignment="Center" Padding="6,0"
                             ToolTip="留空表示跟随全局"/>
                    <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" Foreground="#1A1A1A"/>
                    <TextBlock Text="初始" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="13" Foreground="#1A1A1A"/>
                    <TextBox Text="{Binding MinMemory, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" Margin="8,0,0,0" Height="26" FontSize="13"
                             VerticalContentAlignment="Center" Padding="6,0"
                             ToolTip="留空表示跟随全局"/>
                    <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" Foreground="#1A1A1A"/>
                </StackPanel>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}" Text="{Binding GlobalMemoryHint}"/>

                <TextBlock Text="Java 运行时" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                             Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                             ToolTip="留空表示跟随全局设置"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SkinButton}"
                            Command="{Binding BrowseJavaCommand}"
                            Content="浏览…" Width="72" Height="26" FontSize="13"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}"
                           Text="留空时跟随全局设置；指定后启动前会先检测这个 java 是否可用。"/>

                <TextBlock Text="游戏窗口" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Width="120" Height="28" FontSize="13"
                              ItemsSource="{Binding InstanceWindowModeOptions}"
                              SelectedItem="{Binding SelectedWindowMode, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1" Width="150" Height="28" FontSize="13" Margin="10,0,0,0"
                              IsEditable="True"
                              ItemsSource="{Binding WindowSizePresets}"
                              Text="{Binding WindowSize, UpdateSourceTrigger=LostFocus}"
                              ToolTip="选择预设或直接输入「宽x高」；留空跟随全局"/>
                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource BodyText}"
                               Text="留空跟随全局"/>
                </Grid>

                <TextBlock Text="附加启动参数" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                <TextBlock Style="{StaticResource BodyText}" Text="JVM 参数（留空跟随全局）"/>
                <TextBox Text="{Binding ExtraJvmArgs, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0" Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
                <TextBlock Style="{StaticResource BodyText}" Text="游戏参数（留空跟随全局）" Margin="0,8,0,0"/>
                <TextBox Text="{Binding ExtraGameArgs, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0" Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
