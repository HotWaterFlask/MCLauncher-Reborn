<UserControl x:Class="MCLauncher.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <Grid>
        <!-- 左上角账号块：左侧皮肤头像（正版取官方皮肤，离线用默认皮肤），右侧账号名与类型；点击去账号页 -->
        <Button Style="{StaticResource AccountBlockButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16,14,0,0"
                Command="{Binding OpenAccountsCommand}"
                ToolTip="管理账号">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" SnapsToDevicePixels="True">
                    <Image Source="{Binding AccountAvatar}"
                           Stretch="UniformToFill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <StackPanel Margin="10,0,2,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountName}"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding AccountTypeText}"
                               Margin="0,2,0,0"
                               FontSize="11" Foreground="#B3FFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Button>

        <!-- 启动输出：点击启动后才出现，进度条在这块下面 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,0,0,120" Width="560"
                    Visibility="{Binding HasLaunchOutput, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="8" Padding="10,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#CC000000"/>
                        <Style.Triggers>
                            <!-- 启动失败：面板整体变红，几秒后随面板一起收起 -->
                            <DataTrigger Binding="{Binding IsLaunchFailed}" Value="True">
                                <Setter Property="Background" Value="#CC5A1212"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="2,0,2,6"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="LaunchOutputBox"
                             Text="{Binding LaunchOutput, Mode=OneWay}"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#D4D4D4"
                             FontFamily="Consolas, Courier New, 宋体"
                             FontSize="12"
                             Height="130"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnLaunchOutputChanged"/>
                </StackPanel>
            </Border>
            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLaunchFailed}" Value="True">
                                <Setter Property="Foreground" Value="#E0575D"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding LaunchSpeedText}"
                       Style="{StaticResource SpeedText}"
                       Foreground="#B3FFFFFF" HorizontalAlignment="Left" Margin="2,4,0,0"/>
            <ItemsControl ItemsSource="{Binding LaunchFiles}" Margin="0,2,0,0"
                          ItemTemplate="{StaticResource DownloadFileRowDarkTemplate}"/>
        </StackPanel>

        <!-- 更新游戏：校验与补全文件的进度弹窗 -->
        <Grid Background="#66000000" Panel.ZIndex="30"
              Visibility="{Binding IsUpdateDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="400" Background="White" CornerRadius="8" Padding="18,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#D8D8D8" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="更新游戏" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    <TextBlock Text="{Binding SelectedVersion.Display}" Margin="0,4,0,0"
                               FontSize="11" Foreground="#7A7A7A" TextTrimming="CharacterEllipsis"/>

                    <ProgressBar Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1"
                                 Value="{Binding UpdateProgress, Mode=OneWay}"/>

                    <TextBlock Text="{Binding UpdateSpeedText}" Style="{StaticResource SpeedText}"/>

                    <TextBlock Text="{Binding UpdateStatus}" Margin="0,8,0,0"
                               FontSize="12" Foreground="#5A5A5A" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding UpdateFiles}" Margin="0,4,0,0"
                                  ItemTemplate="{StaticResource DownloadFileRowTemplate}"
                                  Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding UpdateResult}" Margin="0,6,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding HasUpdateResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2F6FB6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateResultFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button HorizontalAlignment="Right" Margin="0,14,0,0"
                            Width="76" Height="28" FontSize="12" Content="关闭"
                            Command="{Binding CloseUpdateDialogCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SkinButton}">
                                <Style.Triggers>
                                    <!-- 补全进行中不允许关闭弹窗 -->
                                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 原版右下角控件区：列宽 145/16/92、行高 31/10/31/16/30、右/下边距 37/33 -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,37,33">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="31"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="31"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding LaunchCommand}"
                    Content="启动游戏"
                    FontSize="20" FontWeight="Bold"/>

            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding CompleteCommand}"
                    Content="更新游戏"
                    FontSize="13"
                    ToolTip="校验并补全缺失文件"/>

            <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding SettingsCommand}"
                    Content="设置"
                    FontSize="13"/>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Left">
                <ComboBox Width="180" Height="30"
                          VerticalAlignment="Center"
                          FontSize="14" Foreground="#1A1A1A"
                          ItemsSource="{Binding Versions}"
                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          ToolTip="选择要启动的版本"/>
                <Button Style="{StaticResource CreditLink}"
                        Command="{Binding OpenFolderCommand}"
                        Content="打开目录"
                        FontSize="15"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
