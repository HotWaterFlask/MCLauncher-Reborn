<UserControl x:Class="MCLauncher.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <Grid>
        <!-- 完整态下的信息层（紧凑态隐藏，保持与原版一致的观感） -->
        <StackPanel VerticalAlignment="Top"
                    Margin="20,18,20,0"
                    Visibility="{Binding DataContext.FullMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="MineCraft Launcher 6.0 Reborn" Style="{StaticResource PageTitle}"/>
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource BodyText}"
                       Text="{Binding AccountText}"/>
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource BodyText}"
                       Text="{Binding StatusText}"/>
            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="1"
                         Width="420" HorizontalAlignment="Left"
                         Value="{Binding Progress, Mode=OneWay}"/>
        </StackPanel>

        <!-- 原版右下角控件区：列宽 145/16/92、行高 31/10/31/16/30、右/下边距 37/33 -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,37,33">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="31"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="31"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding LaunchCommand}"
                    Content="启动游戏"
                    FontSize="20" FontWeight="Bold"/>

            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding CompleteCommand}"
                    Content="更新游戏"
                    FontSize="13"
                    ToolTip="校验并补全缺失文件"/>

            <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding SettingsCommand}"
                    Content="设置"
                    FontSize="13"/>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Left">
                <ComboBox Width="180" Height="30"
                          VerticalAlignment="Center"
                          FontSize="14" Foreground="#1A1A1A"
                          ItemsSource="{Binding Versions}"
                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          ToolTip="选择要启动的版本"/>
                <Button Style="{StaticResource CreditLink}"
                        Command="{Binding OpenFolderCommand}"
                        Content="打开目录"
                        FontSize="15"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
