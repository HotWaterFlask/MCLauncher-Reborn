<UserControl x:Class="MCLauncher.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <Grid>
        <!-- 左上角账号块：左侧皮肤头像（正版取官方皮肤，离线用默认皮肤），右侧账号名与类型；点击去账号页 -->
        <Button Style="{StaticResource AccountBlockButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16,14,0,0"
                Command="{Binding OpenAccountsCommand}"
                ToolTip="管理账号">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" SnapsToDevicePixels="True">
                    <Image Source="{Binding AccountAvatar}"
                           Stretch="UniformToFill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <StackPanel Margin="10,0,2,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountName}"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding AccountTypeText}"
                               Margin="0,2,0,0"
                               FontSize="11" Foreground="#B3FFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Button>

        <!-- 启动输出：点击启动后才出现，进度条在这块下面 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,0,0,120" Width="560"
                    Visibility="{Binding HasLaunchOutput, Converter={StaticResource BoolToVis}}">
            <Border Background="#CC000000" CornerRadius="8" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="2,0,2,6"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="LaunchOutputBox"
                             Text="{Binding LaunchOutput, Mode=OneWay}"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#D4D4D4"
                             FontFamily="Consolas, Courier New, 宋体"
                             FontSize="12"
                             Height="130"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnLaunchOutputChanged"/>
                </StackPanel>
            </Border>
            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}"/>
        </StackPanel>

        <!-- 原版右下角控件区：列宽 145/16/92、行高 31/10/31/16/30、右/下边距 37/33 -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,37,33">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="31"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="31"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding LaunchCommand}"
                    Content="启动游戏"
                    FontSize="20" FontWeight="Bold"/>

            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding CompleteCommand}"
                    Content="更新游戏"
                    FontSize="13"
                    ToolTip="校验并补全缺失文件"/>

            <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding SettingsCommand}"
                    Content="设置"
                    FontSize="13"/>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Left">
                <ComboBox Width="180" Height="30"
                          VerticalAlignment="Center"
                          FontSize="14" Foreground="#1A1A1A"
                          ItemsSource="{Binding Versions}"
                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          ToolTip="选择要启动的版本"/>
                <Button Style="{StaticResource CreditLink}"
                        Command="{Binding OpenFolderCommand}"
                        Content="打开目录"
                        FontSize="15"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
